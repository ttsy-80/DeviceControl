<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingVertical="@dimen/spacing_medium">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发动机控制系统"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/on_background"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_medium" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Engine Control System"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_small" />

    <!-- Model Management Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModelManagement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="型号管理"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="管理发动机型号和配置项"
                android:textSize="14sp"
                android:visibility="gone"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelManagement"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="进入型号管理"
                style="@style/AccentButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Task Create Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskCreate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardModelManagement"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测任务"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="创建新的发动机检测任务"
                android:textSize="14sp"
                android:visibility="gone"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTaskCreate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="检测任务"
                style="@style/AccentButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Task List Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardTaskCreate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务列表"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看和管理所有检测任务"
                android:textSize="14sp"
                android:visibility="gone"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTaskList"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="进入任务列表"
                style="@style/AccentButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Task Control Card - Hidden for now -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTaskControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardTaskList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务控制"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行和控制发动机任务"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTaskControl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="任务控制"
                style="@style/AccentButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
