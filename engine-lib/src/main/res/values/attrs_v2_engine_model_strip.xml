<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="V2EngineModelStripTextView">
        <attr name="v2EngineStripGradientStartColor" format="color" />
        <attr name="v2EngineStripGradientEndColor" format="color" />
        <!-- 渐变方向角度（度），0=从左到右 -->
        <attr name="v2EngineStripGradientAngle" format="float" />
        <!-- 左侧自上至下外斜切与竖直线夹角（度），默认 45 -->
        <attr name="v2EngineStripLeftEdgeAngle" format="float" />
        <attr name="v2EngineStripTopRightRadius" format="dimension" />
        <attr name="v2EngineStripBottomRightRadius" format="dimension" />
    </declare-styleable>
</resources>
