<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Control Panel - 平板横屏适配 -->
    <!-- 控制按钮尺寸：90dp × 45dp → 140dp × 70dp -->
    <dimen name="control_button_size">140dp</dimen>
    <dimen name="control_button_height">70dp</dimen>
    <dimen name="control_button_margin">16dp</dimen>
    
    <!-- 控制按钮文本大小：14sp → 20sp -->
    <dimen name="control_button_text_size">20sp</dimen>
    
    <!-- Control top - 切换任务按钮：87dp × 36dp → 120dp × 50dp -->
    <dimen name="control_top_button_task_width">120dp</dimen>
    <dimen name="control_top_button_task_height">50dp</dimen>
    
    <!-- 切换任务按钮和任务索引文本大小：14sp → 18sp -->
    <dimen name="control_top_button_text_size">18sp</dimen>
    
    <!-- 控制区域边距：25dp → 40dp -->
    <dimen name="control_panel_margin_horizontal">40dp</dimen>
    <dimen name="control_panel_margin_between">40dp</dimen>
    
    <!-- 控制面板顶部和底部边距 -->
    <dimen name="control_panel_padding_top">32dp</dimen>
    <dimen name="control_panel_padding_bottom">24dp</dimen>
    
    <!-- 控制区域内边距：16dp → 24dp -->
    <dimen name="control_panel_inner_padding">24dp</dimen>
</resources>
