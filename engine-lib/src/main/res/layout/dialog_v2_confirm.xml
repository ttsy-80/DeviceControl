<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvConfirmBanner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/v2_primary"
        android:gravity="center"
        android:textColor="@color/v2_on_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/v2_surface"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/v2_text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConfirmCancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_v2_menu_normal"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingHorizontal="24dp"
                android:textColor="@color/v2_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnConfirmOk"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingHorizontal="24dp"
                android:textColor="@color/v2_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
