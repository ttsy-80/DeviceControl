<?xml version="1.0" encoding="utf-8"?>
<!-- P15～P17 型号详情：左引擎信息灰底 | 右表格 + 编辑/返回 + 品牌脚注 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：引擎信息（圆角灰底） -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_v2_panel_grey"
            android:clipToOutline="true">

            <include
                android:id="@+id/includeEnginePanel"
                layout="@layout/include_v2_model_engine_panel" />
        </FrameLayout>

        <!-- 右：表格区 + 底栏按钮 + 公司名 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 表头：顶部圆角，列表外框在 rvDetailRows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_inspection_table_header_h"
                    android:background="@drawable/bg_v2_edit_detail_header"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/v2_col_position"
                        android:textColor="@color/v2_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/v2_col_blade"
                        android:textColor="@color/v2_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:gravity="center"
                        android:text="@string/v2_col_action"
                        android:textColor="@color/v2_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 列表区：橙色外框仅在 rvDetailRows -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_v2_panel_grey2"
                    android:padding="10dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_v2_model_add_table"
                        android:padding="1dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDetailRows"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/v2_surface"
                            android:clipToPadding="true"
                            android:fadeScrollbars="false"
                            android:overScrollMode="ifContentScrolls"
                            android:scrollbarSize="@dimen/v2_p6_scrollbar_width"
                            android:scrollbarStyle="insideOverlay"
                            android:scrollbarThumbVertical="@drawable/bg_v2_scrollbar_thumb"
                            android:scrollbarTrackVertical="@drawable/bg_v2_scrollbar_track"
                            android:scrollbars="vertical" />
                    </FrameLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- 编辑 / 返回 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/btnDetailEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_v2_model_action_orange"
                    android:gravity="center"
                    android:minWidth="160dp"
                    android:paddingHorizontal="36dp"
                    android:text="@string/v2_edit"
                    android:textColor="@color/v2_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDetailSave"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_v2_model_action_orange"
                    android:gravity="center"
                    android:minWidth="160dp"
                    android:paddingHorizontal="36dp"
                    android:text="@string/v2_save"
                    android:textColor="@color/v2_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnDetailBack"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_v2_model_action_orange"
                    android:gravity="center"
                    android:minWidth="140dp"
                    android:paddingHorizontal="36dp"
                    android:text="@string/v2_return"
                    android:textColor="@color/v2_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.3"
                    android:layout_gravity="center"
                    android:text="@string/v2_company_cn"
                    android:textColor="@color/v2_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.3"
                    android:layout_gravity="center"
                    android:fontFamily="serif"
                    android:text="@string/v2_company_en"
                    android:textColor="@color/v2_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
