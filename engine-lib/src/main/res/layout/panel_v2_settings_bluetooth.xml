<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <include
        android:id="@+id/footerInclude"
        layout="@layout/include_v2_settings_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/v2_settings_footer_margin_bottom"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvBluetoothTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/v2_settings_content_padding_top"
        android:layout_marginBottom="@dimen/v2_settings_panel_title_margin_bottom"
        android:text="@string/v2_bluetooth_title"
        android:textColor="@color/v2_text_primary"
        android:textSize="@dimen/v2_settings_panel_title_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPanelContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/v2_settings_content_padding_bottom"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/footerInclude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBluetoothTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/llDeviceList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDevice1"
                    style="@style/V2SettingsListRow" />

                <TextView
                    android:id="@+id/tvDevice2"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap" />

                <TextView
                    android:id="@+id/tvDevice3"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap" />

                <TextView
                    android:id="@+id/tvDevice4"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap" />

                <TextView
                    android:id="@+id/tvDevice5"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnConfirmConnect"
                style="@style/V2SettingsActionButton"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/v2_confirm_connect" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
