<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIconTint="@color/on_primary"
            app:title="任务控制"
            app:titleTextColor="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Status Bar (Top) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            android:layout_marginHorizontal="@dimen/status_bar_margin_horizontal"
            android:layout_marginTop="@dimen/status_bar_margin_top"
            android:background="@drawable/bg_task_control_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium"
            android:paddingHorizontal="@dimen/status_bar_padding_horizontal">

            <TextView
                android:id="@+id/tvStatusBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="状态栏: CFM56-38 LPC2-20/46 点动 速度: 5分钟/圈"
                android:textColor="@color/color_black"
                android:textSize="@dimen/status_bar_text_size" />

            <Button
                android:id="@+id/btnSwitchTask"
                android:layout_width="@dimen/control_top_button_task_width"
                android:layout_height="@dimen/control_top_button_task_height"
                android:layout_marginEnd="@dimen/spacing_small"
                android:text="切换任务"
                android:includeFontPadding="false"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/control_top_button_text_size"
                android:background="@drawable/bg_switch_task_button"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvTaskIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务: 1/2"
                android:textColor="@color/color_666666"
                android:textSize="@dimen/control_top_button_text_size"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Control Panel (Below Task Info Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/control_panel_margin_horizontal"
            android:paddingTop="@dimen/control_panel_padding_top"
            android:paddingBottom="@dimen/control_panel_padding_bottom">

            <!-- Left: Control Buttons Grid (scrollable) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"
                android:layout_marginEnd="@dimen/control_panel_margin_between"
                android:background="@drawable/bg_task_control_bottom"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="0dp"
                        android:layout_gravity="center_horizontal"
                        app:cardBackgroundColor="@null"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_gravity="center_horizontal"
                            android:padding="@dimen/control_panel_inner_padding">

                            <!-- Row 1: 启动、暂停（中间空一格） -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnStartPause"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/start"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <!-- 空位 -->
                                <View
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin" />

                                <Button
                                    android:id="@+id/btnPause"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/pause"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />
                            </LinearLayout>

                            <!-- Row 2: 正转、反转、拍照 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnForward"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/forward"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnReverse"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/reverse"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnPhoto"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/photo"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />
                            </LinearLayout>

                            <!-- Row 3: 速度+、速度-、记录 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnSpeedPlus"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/speed_plus"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnSpeedMinus"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/speed_minus"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnAddRecord"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/record"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />
                            </LinearLayout>

                            <!-- Row 4: 连续、点动、设置 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnContinuous"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/continuous"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnJog"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/jog"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnSettings"
                                    android:layout_width="@dimen/control_button_size"
                                    android:layout_height="@dimen/control_button_height"
                                    android:layout_margin="@dimen/control_button_margin"
                                    android:text="@string/settings"
                                    android:textSize="@dimen/control_button_text_size"
                                    android:background="@drawable/selector_control_button"
                                    android:textColor="@color/selector_control_button_text"
                                    android:textAllCaps="false"
                                    app:backgroundTint="@null" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.core.widget.NestedScrollView>

            </LinearLayout>


            <!-- Right: Records List -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:background="@drawable/bg_task_control_bottom"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/records_list_padding_horizontal">

                <!-- Records List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecords"
                    android:layout_width="match_parent"
                    android:paddingTop="@dimen/records_list_padding_top"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
