<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="任务控制"
            app:titleTextColor="@color/on_primary"
            app:navigationIconTint="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Task Info Card (Top) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvTaskInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CFM56-3B | LPC2-33/46 | 点动"
                    android:textColor="@color/on_primary_container"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/engine_torque_speed"
                        android:textColor="@color/on_primary_container"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTaskIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="任务 1/1"
                        android:textColor="@color/on_primary_container"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_task_index"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_small"
                        android:paddingBottom="@dimen/spacing_small"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Task Navigation Buttons (多任务时显示) -->
                <LinearLayout
                    android:id="@+id/llTaskNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviousTask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:text="@string/previous_task"
                        android:textSize="14sp"
                        android:drawableStart="@drawable/ic_arrow_back"
                        android:drawablePadding="@dimen/spacing_small"
                        android:drawableTint="@color/on_primary_container"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:backgroundTint="@android:color/transparent"
                        android:textColor="@color/on_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextTask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/next_task"
                        android:textSize="14sp"
                        android:drawableEnd="@drawable/ic_arrow_forward"
                        android:drawablePadding="@dimen/spacing_small"
                        android:drawableTint="@color/on_primary_container"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:backgroundTint="@android:color/transparent"
                        android:textColor="@color/on_primary_container" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Control Panel (Below Task Info Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="@dimen/control_panel_padding"
            android:gravity="center_vertical">

        <!-- Left: Control Buttons Grid (scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.0"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium"
                    android:gravity="center">

                    <!-- Row 1: 启动、暂停（中间空一格） -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartPause"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/start"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_green" />

                        <!-- 空位 -->
                        <View
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPause"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/pause"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/secondary" />
                    </LinearLayout>

                    <!-- Row 2: 正转、反转、拍照 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnForward"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/forward"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_blue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReverse"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/reverse"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_blue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPhoto"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/photo"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/secondary" />
                    </LinearLayout>

                    <!-- Row 3: 速度+、速度-、记录 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeedPlus"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/speed_plus"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_blue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeedMinus"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/speed_minus"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_blue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddRecord"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/record"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/accent_green" />
                    </LinearLayout>

                    <!-- Row 4: 连续、点动（居中显示） -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContinuous"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/continuous"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJog"
                            android:layout_width="@dimen/control_button_size"
                            android:layout_height="@dimen/control_button_size"
                            android:layout_margin="@dimen/control_button_margin"
                            android:text="@string/jog"
                            android:textSize="14sp"
                            style="@style/ControlButton"
                            app:backgroundTint="@color/secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

        <!-- Right: Records List -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:layout_marginStart="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Records List Section Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="记录列表"
                    android:textColor="@color/on_primary_container"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <!-- Records List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecords"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
