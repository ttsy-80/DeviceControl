<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- 左侧：菜单与返回主界面上下分区，避免返回按钮遮挡菜单 -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="@dimen/v2_settings_sidebar_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sidebarScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="true"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/menuBluetooth"
                    style="@style/V2SettingsMenuItem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_menu_item_height"
                    android:text="@string/v2_settings_bluetooth" />

                <TextView
                    android:id="@+id/menuLanguage"
                    style="@style/V2SettingsMenuItem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_menu_item_height"
                    android:layout_marginTop="@dimen/v2_settings_menu_gap"
                    android:text="@string/v2_settings_language" />

                <TextView
                    android:id="@+id/menuUpdate"
                    style="@style/V2SettingsMenuItem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_menu_item_height"
                    android:layout_marginTop="@dimen/v2_settings_menu_gap"
                    android:text="@string/v2_settings_update" />

                <TextView
                    android:id="@+id/menuAbout"
                    style="@style/V2SettingsMenuItem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_menu_item_height"
                    android:layout_marginTop="@dimen/v2_settings_menu_gap"
                    android:text="@string/v2_settings_about" />

                <TextView
                    android:id="@+id/menuManual"
                    style="@style/V2SettingsMenuItem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/v2_menu_item_height"
                    android:layout_marginTop="@dimen/v2_settings_menu_gap"
                    android:text="@string/v2_settings_manual" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/btnBackMain"
            android:layout_width="match_parent"
            android:layout_height="@dimen/v2_settings_back_btn_height"
            android:layout_marginTop="@dimen/v2_settings_sidebar_back_gap"
            android:background="@drawable/bg_v2_settings_back_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/v2_back_main_line1"
                android:textColor="@color/v2_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/v2_back_main_line2"
                android:textColor="@color/v2_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/v2_settings_content_bg"
        android:clipChildren="true"
        android:clipToPadding="true" />
</LinearLayout>
