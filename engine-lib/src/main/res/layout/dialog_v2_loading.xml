<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/v2_primary"
        android:gravity="center"
        android:text="@string/v2_bluetooth_connecting_banner"
        android:textColor="@color/v2_on_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/v2_surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/v2_primary"
            app:indicatorSize="48dp"
            app:trackColor="@color/v2_peach"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/v2_text_primary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
