<?xml version="1.0" encoding="utf-8"?>
<!-- P14 型号添加：左引擎信息 | 右编辑详情表格 + 添加/返回（底栏走 Shell） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_inspection_page_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左：引擎信息 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="32"
            android:background="@drawable/bg_v2_panel_grey"
            android:elevation="2dp">

            <include
                android:id="@+id/includeEnginePanel"
                layout="@layout/include_v2_model_engine_panel" />
        </FrameLayout>

        <!-- 右：编辑详情 + 底部按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="68"
            android:background="@drawable/bg_v2_panel_grey"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/v2_primary"
                android:gravity="center"
                android:text="@string/v2_edit_detail"
                android:textColor="@color/v2_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_model_add_table">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAddDetailRows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbarSize="@dimen/v2_p6_scrollbar_width"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbarThumbVertical="@drawable/bg_v2_scrollbar_thumb"
                    android:scrollbarTrackVertical="@drawable/bg_v2_scrollbar_track"
                    android:scrollbars="vertical" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/btnAddConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_v2_pill_orange"
                    android:gravity="center"
                    android:minWidth="160dp"
                    android:paddingHorizontal="36dp"
                    android:text="@string/v2_add"
                    android:textColor="@color/v2_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddBack"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_v2_pill_orange"
                    android:gravity="center"
                    android:minWidth="140dp"
                    android:paddingHorizontal="36dp"
                    android:text="@string/v2_return"
                    android:textColor="@color/v2_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
