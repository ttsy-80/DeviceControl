<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <include
        android:id="@+id/footerInclude"
        layout="@layout/include_v2_settings_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/v2_settings_footer_margin_bottom"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/v2_settings_content_padding_top"
        android:layout_marginBottom="@dimen/v2_settings_panel_title_margin_bottom"
        android:text="@string/v2_system_upgrade_title"
        android:textColor="@color/v2_text_primary"
        android:textSize="@dimen/v2_settings_panel_title_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPanelContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/v2_settings_content_padding_bottom"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/footerInclude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUpdateTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/flUpdateIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_v2_update_icon_circle">

                <ImageView
                    android:id="@+id/ivUpdateIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_v2_system_update" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/v2_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvLastInspection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/v2_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnCheckUpdate"
                style="@style/V2SettingsActionButton"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/v2_check_update" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
