<?xml version="1.0" encoding="utf-8"?>
<!-- P6：宫格左右等距铺满；底栏行 = 居中公司名 + 右下返回首页（与稿面一致） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_surface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvModels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="@dimen/v2_p6_content_padding_horizontal"
        android:paddingTop="@dimen/v2_p6_content_padding_top"
        android:paddingEnd="@dimen/v2_p6_content_padding_horizontal"
        android:scrollbarSize="@dimen/v2_p6_scrollbar_width"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/bg_v2_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/bg_v2_scrollbar_track"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/p6FooterBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/p6FooterBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/v2_bottom_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/include_v2_bottom_bar" />

        <TextView
            android:id="@+id/btnReturnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/v2_p6_back_home_margin_end"
            android:background="@drawable/bg_v2_pill_orange"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/v2_back_home"
            android:textColor="@color/v2_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
