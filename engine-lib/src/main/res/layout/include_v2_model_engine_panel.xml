<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <com.devicecontrol.engine.v2.ui.widget.V2EngineInfoTabTextView
            android:id="@+id/tvEngineInfoTab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:minWidth="140dp"
            android:paddingHorizontal="10dp"
            android:text="@string/v2_engine_info"
            android:textColor="@color/v2_on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:v2EngineInfoTabBackgroundColor="@color/v2_primary"
            app:v2EngineInfoTabRightEdgeAngle="45"
            app:v2EngineInfoTabTopLeftRadius="@dimen/v2_engine_info_tab_top_left_radius" />

        <com.devicecontrol.engine.v2.ui.widget.V2EngineModelStripTextView
            android:id="@+id/tvPanelModelName"
            android:layout_width="match_parent"
            android:layout_height="23dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/v2_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="120dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:v2EngineStripBottomRightRadius="@dimen/v2_inspection_panel_radius"
            app:v2EngineStripGradientAngle="0"
            app:v2EngineStripGradientEndColor="@color/v2_surface"
            app:v2EngineStripGradientStartColor="@color/v2_peach"
            app:v2EngineStripLeftEdgeAngle="45"
            app:v2EngineStripTopRightRadius="@dimen/v2_inspection_panel_radius" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svEngineContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llEngineFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <FrameLayout
                android:id="@+id/frameImageArea"
                android:layout_width="match_parent"
                android:layout_height="@dimen/v2_engine_import_image_height"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/ivEnginePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_v2_engine_photo"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_v2_engine_placeholder"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btnImportImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_v2_import_image"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_v2_import_img"
                        app:tint="@color/v2_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/v2_import_image"
                        android:textColor="@color/v2_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
