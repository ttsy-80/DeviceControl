<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_v2_engine_info_tab"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/v2_engine_info"
            android:textColor="@color/v2_on_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPanelModelName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_v2_engine_model_strip"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:textColor="@color/v2_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llEngineFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <FrameLayout
        android:id="@+id/frameImageArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/ivEnginePhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_v2_engine_photo"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v2_engine_placeholder"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/btnImportImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_v2_import_image"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_v2_add_model" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/v2_import_image"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
