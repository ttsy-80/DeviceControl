<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <include
        android:id="@+id/footerInclude"
        layout="@layout/include_v2_settings_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/v2_settings_footer_margin_bottom"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvLanguageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/v2_settings_content_padding_top"
        android:layout_marginBottom="@dimen/v2_settings_panel_title_margin_bottom"
        android:text="@string/v2_language_settings_title"
        android:textColor="@color/v2_text_primary"
        android:textSize="@dimen/v2_settings_panel_title_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPanelContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/v2_settings_content_padding_bottom"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/footerInclude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLanguageTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/llLanguages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/langZh"
                    style="@style/V2SettingsListRow"
                    android:text="@string/v2_lang_zh" />

                <TextView
                    android:id="@+id/langZhTw"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap"
                    android:text="@string/v2_lang_zh_tw" />

                <TextView
                    android:id="@+id/langEn"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap"
                    android:text="ENGLISH" />

                <TextView
                    android:id="@+id/langDe"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap"
                    android:text="DEUTSCH" />

                <TextView
                    android:id="@+id/langFr"
                    style="@style/V2SettingsListRow"
                    android:layout_marginTop="@dimen/v2_settings_list_gap"
                    android:text="FRANÇAIS" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnChangeLanguage"
                style="@style/V2SettingsActionButton"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/v2_change_language" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
