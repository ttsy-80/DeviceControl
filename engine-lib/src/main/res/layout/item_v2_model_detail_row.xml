<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modelDetailRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <EditText
        android:id="@+id/etPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:inputType="text"
        android:textColor="@color/v2_text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etBladeCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:inputType="number"
        android:textColor="@color/v2_text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRowAdd"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_v2_pill_green"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="12dp"
            android:text="@string/v2_add"
            android:textColor="@color/v2_on_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRowSave"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_v2_pill_green"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="12dp"
            android:text="@string/v2_save"
            android:textColor="@color/v2_on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRowDelete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_v2_pill_red"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="12dp"
            android:text="@string/v2_delete"
            android:textColor="@color/v2_on_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
