<?xml version="1.0" encoding="utf-8"?>
<!-- P8/P11 单格：左图标+标签，右 [−] 数值单位 [+] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modeSettingCellRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/v2_mode_setting_row_h"
    android:orientation="horizontal"
    android:paddingStart="@dimen/v2_mode_setting_cell_pad_h"
    android:paddingEnd="12dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivModeSettingIcon"
        android:layout_width="@dimen/v2_mode_setting_icon_size"
        android:layout_height="@dimen/v2_mode_setting_icon_size"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvModeSettingLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/v2_text_primary"
        android:textSize="@dimen/v2_mode_setting_label_text"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/groupStepper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="@dimen/v2_mode_setting_stepper_btn"
            android:layout_height="@dimen/v2_mode_setting_stepper_btn"
            android:background="@drawable/bg_v2_mode_stepper_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/v2_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:minWidth="88dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStepperValue"
                style="@style/V2EditText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:imeOptions="flagNoExtractUi|actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:minWidth="36dp"
                android:textColor="@color/v2_text_primary"
                android:textSize="@dimen/v2_mode_setting_value_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepperUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/v2_text_primary"
                android:textSize="@dimen/v2_mode_setting_value_text"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="@dimen/v2_mode_setting_stepper_btn"
            android:layout_height="@dimen/v2_mode_setting_stepper_btn"
            android:background="@drawable/bg_v2_mode_stepper_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/v2_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
