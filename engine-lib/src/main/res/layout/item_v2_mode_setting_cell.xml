<?xml version="1.0" encoding="utf-8"?>
<!-- P8/P11 单格：图标 + 标签 + [−] 可输入值 [+] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modeSettingCellRoot"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="@dimen/v2_mode_setting_row_h"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivModeSettingIcon"
        android:layout_width="@dimen/v2_mode_setting_icon_size"
        android:layout_height="@dimen/v2_mode_setting_icon_size"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvModeSettingLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="@color/v2_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnMinus"
        android:layout_width="@dimen/v2_mode_setting_stepper_btn"
        android:layout_height="@dimen/v2_mode_setting_stepper_btn"
        android:background="@drawable/bg_v2_stepper_btn_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="−"
        android:textColor="@color/v2_on_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_v2_mode_setting_value"
        android:gravity="center_vertical"
        android:minWidth="96dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/etStepperValue"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/v2_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepperUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/v2_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnPlus"
        android:layout_width="@dimen/v2_mode_setting_stepper_btn"
        android:layout_height="@dimen/v2_mode_setting_stepper_btn"
        android:background="@drawable/bg_v2_stepper_btn_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/v2_on_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
