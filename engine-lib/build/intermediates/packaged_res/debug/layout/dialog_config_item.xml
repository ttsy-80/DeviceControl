<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="600dp"
    android:fillViewport="true"
    android:background="@color/surface">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加配置项"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_large" />

    <!-- Gear Ratio -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:hint="@string/gear_ratio"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:startIconDrawable="@android:drawable/ic_menu_sort_by_size"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGearRatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="@dimen/button_height_compact" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Position -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:hint="@string/position"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:startIconDrawable="@android:drawable/ic_menu_mylocation"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            android:minHeight="@dimen/button_height_compact" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Blade Count -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:hint="@string/blade_count"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:startIconDrawable="@android:drawable/ic_menu_view"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBladeCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            android:inputType="number"
            android:minHeight="@dimen/button_height_compact" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Jog Count -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:hint="@string/jog_count"
        app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
        app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
        app:startIconDrawable="@android:drawable/ic_menu_recent_history"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etJogCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="flagNoExtractUi"
            android:inputType="number"
            android:minHeight="@dimen/button_height_compact" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_compact"
            android:text="@string/cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginEnd="@dimen/spacing_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_compact"
            android:text="@string/confirm"
            android:visibility="visible"
            android:enabled="true"
            style="@style/AccentButton" />
    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>