<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="任务控制"
            app:titleTextColor="@color/on_primary"
            app:navigationIconTint="@color/on_primary" />

        <!-- Task Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvTaskInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CFM56-3B | LPC2-33/46 | 点动"
                    android:textColor="@color/on_primary_container"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTorqueSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/engine_torque_speed"
                        android:textColor="@color/on_primary_container"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTaskIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="任务 1/1"
                        android:textColor="@color/on_primary_container"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_task_index"
                        android:paddingStart="@dimen/spacing_medium"
                        android:paddingEnd="@dimen/spacing_medium"
                        android:paddingTop="@dimen/spacing_small"
                        android:paddingBottom="@dimen/spacing_small"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Control Panel -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/control_panel_padding"
            android:gravity="center">

            <!-- Control Buttons Grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp"
                android:layout_marginBottom="@dimen/spacing_large">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="4"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="false"
                    android:padding="@dimen/spacing_medium">

                    <!-- Row 1 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartPause"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/start_pause"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForwardReverse"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/forward_reverse"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJogContinuous"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/jog_continuous"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/secondary" />

                    <!-- Row 2 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettings"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/settings"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/tertiary"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/stop"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/error" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviousTask"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/previous_task"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_orange"
                        android:visibility="gone" />

                    <!-- Row 3 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTorquePlus"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/torque_plus"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_orange" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTorqueMinus"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/torque_minus"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_orange" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextTask"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/next_task"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_orange"
                        android:visibility="gone" />

                    <!-- Row 4 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeedPlus"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/speed_plus"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeedMinus"
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin"
                        android:text="@string/speed_minus"
                        android:textSize="14sp"
                        style="@style/ControlButton"
                        app:backgroundTint="@color/accent_blue" />

                    <View
                        android:layout_width="@dimen/control_button_size"
                        android:layout_height="@dimen/control_button_size"
                        android:layout_margin="@dimen/control_button_margin" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
